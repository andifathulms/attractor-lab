{
  "name": "attractor-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build && touch out/.nojekyll",
    "preview": "pnpm build && npx serve out",
    "test": "vitest",
    "test:run": "vitest run",
    "test:analytic": "vitest run tests/analytic",
    "test:order": "vitest run tests/order",
    "test:constants": "vitest run tests/constants",
    "test:export": "vitest run tests/export",
    "bench:points": "tsx tests/bench/points.bench.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.0",
    "typescript": "5.5.4",
    "vitest": "^1.6.0"
  }
}
